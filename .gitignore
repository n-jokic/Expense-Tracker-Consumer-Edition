.streamlit/secrets.toml

# ── Environment / secret files ─────────────────────────────────────────────────
.env
*.env
secrets.toml
.secret_key

# ── OS clutter ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

